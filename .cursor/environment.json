{
  "name": "E2 web (site)",
  "install": "bash scripts/cloud-install.sh",
  "start": "bash scripts/cloud-start.sh",
  "terminals": [
    {
      "name": "site",
      "command": "python3 -m http.server 8019"
    }
  ],
  "egressMode": "default_with_network_settings",
  "egressAllowlist": [
    "github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "codeload.github.com",
    "registry.npmjs.org",
    "niagaraassembly.com"
  ]
}
